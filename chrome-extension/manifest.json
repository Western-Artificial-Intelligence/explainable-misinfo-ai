{
  "manifest_version": 3,
  "name": "TruthLens",
  "description": "AI-powered real-time misinformation detection",
  "version": "1.0.0",
  "web_accessible_resources": [
    {
      "resources": ["tesseract.min.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "webRequest",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"  
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TruthLens",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "audio-capture.js",
        "image-capture.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}

