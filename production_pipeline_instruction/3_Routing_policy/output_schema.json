{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truthlens.ai/schemas/3_routing_policy/output_schema.json",
  "title": "3_Routing_policy - Output Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "claim_id",
    "user_claim",
    "normalized_claim",
    "roberta",
    "routing",
    "meta"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "user_claim": {
      "type": "string",
      "minLength": 1
    },
    "normalized_claim": {
      "type": "string",
      "minLength": 1
    },
    "roberta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "confidence",
        "model",
        "tokenization"
      ],
      "properties": {
        "label": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logits",
            "probs",
            "class_id",
            "class_name"
          ],
          "properties": {
            "logits": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "probs": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "class_id": {
              "type": "integer",
              "enum": [
                0,
                1,
                2
              ],
              "description": "Argmax over 3-way label probs. Mapping: 0=false, 1=mixed, 2=true."
            },
            "class_name": {
              "type": "string",
              "enum": [
                "false",
                "mixed",
                "true"
              ],
              "description": "3-way label name. NEI is not produced."
            }
          },
          "description": "3-way label prediction only: {false=0, mixed=1, true=2}. NEI is not produced in this pipeline."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "embedding": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "revision",
            "ctx_tokens"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "ctx_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tokenization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "truncated",
            "input_tokens"
          ],
          "properties": {
            "truncated": {
              "type": "boolean"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_name",
        "policy_version",
        "tier",
        "rag"
      ],
      "properties": {
        "policy_name": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "standard",
            "expanded",
            "conservative"
          ],
          "description": "Routing bucket derived from model confidence/flags."
        },
        "rag": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_pool_size_m",
            "mmr_top_n",
            "mmr_lambda",
            "final_top_k",
            "min_relevance",
            "use_query_expansion",
            "allow_web_search"
          ],
          "properties": {
            "candidate_pool_size_m": {
              "type": "integer",
              "minimum": 1,
              "description": "Candidate pool size M for retrieval (before MMR). Must satisfy 1 <= final_top_k <= mmr_top_n <= candidate_pool_size_m."
            },
            "mmr_top_n": {
              "type": "integer",
              "minimum": 1,
              "description": "MMR selection size N from the candidate pool. Must satisfy 1 <= final_top_k <= mmr_top_n <= candidate_pool_size_m."
            },
            "mmr_lambda": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "MMR tradeoff parameter λ in [0,1]. Higher favors relevance; lower favors diversity."
            },
            "final_top_k": {
              "type": "integer",
              "minimum": 1,
              "description": "Final top-K chunks after relevance gate. Must satisfy 1 <= final_top_k <= mmr_top_n <= candidate_pool_size_m."
            },
            "min_relevance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Relevance threshold T in [0,1]. Cosine similarity is in [-1,1]; using T in [0,1] means any negative cosine always fails the threshold. Defined as: T <= cosine(embed(claim), embed(chunk)), using the same embedding model for both (see Stage 7)."
            },
            "use_query_expansion": {
              "type": "boolean"
            },
            "allow_web_search": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received_at",
        "version"
      ],
      "properties": {
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stage_latencies_ms": {
          "type": "object",
          "description": "Per-stage latency in milliseconds, keyed by stage name.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total end-to-end latency in milliseconds (sum of stage latencies plus overhead)."
        },
        "stage_errors": {
          "type": "array",
          "description": "Non-fatal stage errors encountered during processing (pipeline continued).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "code",
              "message"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "description": "Optional structured details for debugging.",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}
