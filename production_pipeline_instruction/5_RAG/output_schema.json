{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truthlens.ai/schemas/5_rag_retrieval/output_schema.json",
  "title": "5_RAG_retrieval - Output Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "claim_id",
    "user_claim",
    "normalized_claim",
    "roberta",
    "routing",
    "query_plan",
    "rag_candidates",
    "meta"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "user_claim": {
      "type": "string",
      "minLength": 1
    },
    "normalized_claim": {
      "type": "string",
      "minLength": 1
    },
    "roberta": {
      "$ref": "../4_Query_Building/output_schema.json#/properties/roberta"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_name",
        "policy_version",
        "tier",
        "rag"
      ],
      "properties": {
        "policy_name": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "standard",
            "expanded",
            "conservative"
          ]
        },
        "rag": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_pool_size_m",
            "mmr_top_n",
            "mmr_lambda",
            "final_top_k",
            "min_relevance",
            "use_query_expansion",
            "allow_web_search"
          ],
          "properties": {
            "candidate_pool_size_m": {
              "type": "integer",
              "minimum": 1,
              "description": "Candidate pool size M for retrieval (before MMR). Must satisfy 1 <= final_top_k <= mmr_top_n <= candidate_pool_size_m."
            },
            "mmr_top_n": {
              "type": "integer",
              "minimum": 1,
              "description": "MMR selection size N from the candidate pool. Must satisfy 1 <= final_top_k <= mmr_top_n <= candidate_pool_size_m."
            },
            "mmr_lambda": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "MMR tradeoff parameter λ in [0,1]. Higher favors relevance; lower favors diversity."
            },
            "final_top_k": {
              "type": "integer",
              "minimum": 1,
              "description": "Final top-K chunks after relevance gate. Must satisfy 1 <= final_top_k <= mmr_top_n <= candidate_pool_size_m."
            },
            "min_relevance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Relevance threshold T in [0,1]. Cosine similarity is in [-1,1]; using T in [0,1] means any negative cosine always fails the threshold. Defined as: T <= cosine(embed(claim), embed(chunk)), using the same embedding model for both (see Stage 7)."
            },
            "use_query_expansion": {
              "type": "boolean"
            },
            "allow_web_search": {
              "type": "boolean"
            },
            "connect_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "description": "TCP/connect timeout for fetch requests (ms)."
            },
            "read_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "description": "Read timeout for fetch requests (ms)."
            },
            "max_response_bytes": {
              "type": "integer",
              "minimum": 1024,
              "description": "Maximum bytes to read per fetched document."
            },
            "allowed_content_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Allowlist of Content-Types eligible for parsing."
            },
            "allow_pdf": {
              "type": "boolean",
              "description": "If false, skip application/pdf responses."
            },
            "respect_robots": {
              "type": "boolean",
              "description": "If true, respect robots.txt and site access policies."
            },
            "paywall_policy": {
              "type": "string",
              "enum": [
                "skip",
                "extract_snippet",
                "allow"
              ],
              "description": "Behavior when paywall detected."
            },
            "js_heavy_policy": {
              "type": "string",
              "enum": [
                "skip",
                "fallback_reader",
                "allow"
              ],
              "description": "Behavior when JS-heavy page detected."
            },
            "per_domain_rps": {
              "type": "number",
              "minimum": 0,
              "description": "Per-domain request rate limit (requests per second). 0 disables limiting."
            },
            "cache_enabled": {
              "type": "boolean",
              "description": "Enable caching of fetched documents and parsed chunks."
            },
            "cache_ttl_s": {
              "type": "integer",
              "minimum": 0,
              "description": "Cache TTL in seconds. 0 means no TTL (cache eviction policy dependent)."
            }
          }
        }
      }
    },
    "query_plan": {
      "$ref": "../4_Query_Building/output_schema.json#/properties/query_plan"
    },
    "rag_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_size_m",
        "items",
        "sources"
      ],
      "properties": {
        "pool_size_m": {
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "bm25",
              "vector",
              "web"
            ]
          }
        },
        "items": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chunk_id",
              "chunk_kind",
              "span",
              "text",
              "doc",
              "score",
              "query_used"
            ],
            "properties": {
              "chunk_id": {
                "type": "string",
                "minLength": 1
              },
              "chunk_kind": {
                "type": "string",
                "enum": [
                  "paragraph",
                  "window"
                ],
                "description": "How this chunk was created."
              },
              "span": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "p_start",
                  "p_end"
                ],
                "description": "Paragraph index span inside the extracted article text (inclusive range).",
                "properties": {
                  "p_start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "p_end": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "doc": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "doc_id",
                  "source",
                  "title",
                  "url"
                ],
                "properties": {
                  "doc_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "published_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "score": {
                "type": "number"
              },
              "query_used": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received_at",
        "version"
      ],
      "properties": {
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stage_latencies_ms": {
          "type": "object",
          "description": "Per-stage latency in milliseconds, keyed by stage name.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total end-to-end latency in milliseconds (sum of stage latencies plus overhead)."
        },
        "stage_errors": {
          "type": "array",
          "description": "Non-fatal stage errors encountered during processing (pipeline continued).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "code",
              "message"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "description": "Optional structured details for debugging.",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}
