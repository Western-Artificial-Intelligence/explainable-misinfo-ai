{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truthlens.ai/schemas/5_rag_retrieval/input_schema.json",
  "title": "5_RAG_retrieval - Input Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "claim_id",
    "user_claim",
    "normalized_claim",
    "roberta",
    "routing",
    "query_plan",
    "meta"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "user_claim": {
      "type": "string",
      "minLength": 1
    },
    "normalized_claim": {
      "type": "string",
      "minLength": 1
    },
    "roberta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "confidence",
        "model",
        "tokenization"
      ],
      "properties": {
        "label": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logits",
            "probs",
            "class_id",
            "class_name"
          ],
          "properties": {
            "logits": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "probs": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "class_id": {
              "type": "integer",
              "enum": [
                0,
                1,
                2
              ]
            },
            "class_name": {
              "type": "string",
              "enum": [
                "false",
                "mixed",
                "true"
              ]
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "embedding": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "revision",
            "ctx_tokens"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "ctx_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tokenization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "truncated",
            "input_tokens"
          ],
          "properties": {
            "truncated": {
              "type": "boolean"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_name",
        "policy_version",
        "tier",
        "rag"
      ],
      "properties": {
        "policy_name": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "standard",
            "expanded",
            "conservative"
          ]
        },
        "rag": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_pool_size_m",
            "mmr_top_n",
            "mmr_lambda",
            "final_top_k",
            "min_relevance",
            "use_query_expansion",
            "allow_web_search"
          ],
          "properties": {
            "candidate_pool_size_m": {
              "type": "integer",
              "minimum": 1,
              "description": "Candidate pool size M for retrieval (before MMR). Must satisfy 1 <= final_top_k <= mmr_top_n <= candidate_pool_size_m."
            },
            "mmr_top_n": {
              "type": "integer",
              "minimum": 1,
              "description": "MMR selection size N from the candidate pool. Must satisfy 1 <= final_top_k <= mmr_top_n <= candidate_pool_size_m."
            },
            "mmr_lambda": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "MMR tradeoff parameter λ in [0,1]. Higher favors relevance; lower favors diversity."
            },
            "final_top_k": {
              "type": "integer",
              "minimum": 1,
              "description": "Final top-K chunks after relevance gate. Must satisfy 1 <= final_top_k <= mmr_top_n <= candidate_pool_size_m."
            },
            "min_relevance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Relevance threshold T in [0,1]. Defined as cosine similarity between L2-normalized embeddings: T <= cosine(embed(claim), embed(chunk)), using the same embedding model for both (see Stage 7)."
            },
            "use_query_expansion": {
              "type": "boolean"
            },
            "allow_web_search": {
              "type": "boolean"
            },
            "connect_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "description": "TCP/connect timeout for fetch requests (ms)."
            },
            "read_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "description": "Read timeout for fetch requests (ms)."
            },
            "max_response_bytes": {
              "type": "integer",
              "minimum": 1024,
              "description": "Maximum bytes to read per fetched document."
            },
            "allowed_content_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Allowlist of Content-Types eligible for parsing."
            },
            "allow_pdf": {
              "type": "boolean",
              "description": "If false, skip application/pdf responses."
            },
            "respect_robots": {
              "type": "boolean",
              "description": "If true, respect robots.txt and site access policies."
            },
            "paywall_policy": {
              "type": "string",
              "enum": [
                "skip",
                "extract_snippet",
                "allow"
              ],
              "description": "Behavior when paywall detected."
            },
            "js_heavy_policy": {
              "type": "string",
              "enum": [
                "skip",
                "fallback_reader",
                "allow"
              ],
              "description": "Behavior when JS-heavy page detected."
            },
            "per_domain_rps": {
              "type": "number",
              "minimum": 0,
              "description": "Per-domain request rate limit (requests per second). 0 disables limiting."
            },
            "cache_enabled": {
              "type": "boolean",
              "description": "Enable caching of fetched documents and parsed chunks."
            },
            "cache_ttl_s": {
              "type": "integer",
              "minimum": 0,
              "description": "Cache TTL in seconds. 0 means no TTL (cache eviction policy dependent)."
            }
          }
        }
      }
    },
    "query_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "primary_query",
        "queries",
        "paraphrase_meta"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "original_only",
            "original_plus_paraphrases"
          ]
        },
        "primary_query": {
          "type": "string",
          "minLength": 1
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "q",
              "variant"
            ],
            "properties": {
              "q": {
                "type": "string",
                "minLength": 1
              },
              "variant": {
                "type": "string",
                "enum": [
                  "original",
                  "paraphrase"
                ]
              }
            }
          }
        },
        "paraphrase_meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "n_requested",
            "kept",
            "filter"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "n_requested": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "kept": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "filter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min_cosine",
                "require_numbers_match"
              ],
              "properties": {
                "min_cosine": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "require_numbers_match": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received_at",
        "version"
      ],
      "properties": {
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stage_latencies_ms": {
          "type": "object",
          "description": "Per-stage latency in milliseconds, keyed by stage name.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total end-to-end latency in milliseconds (sum of stage latencies plus overhead)."
        },
        "stage_errors": {
          "type": "array",
          "description": "Non-fatal stage errors encountered during processing (pipeline continued).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "code",
              "message"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "description": "Optional structured details for debugging.",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}
