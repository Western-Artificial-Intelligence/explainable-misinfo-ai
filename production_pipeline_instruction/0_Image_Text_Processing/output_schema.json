{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Image/Text Processing Pipeline Output Schema",
  "description": "Output format for Stage 0: Image/Text Processing (claims and predictions)",
  "type": "object",
  "required": ["request_id", "status", "extracted_text"],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^req_img_[0-9]{10}_[a-zA-Z0-9]{6}$",
      "description": "Request identifier (matches input)"
    },
    "claim_id": {
      "type": "string",
      "description": "Associated claim identifier"
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial_success", "error"],
      "description": "Overall processing status"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (if status='error')"
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "details": {
          "type": "string",
          "description": "Detailed error information for debugging"
        }
      }
    },
    "analysis_type": {
      "type": "string",
      "const": "image_and_text_extraction",
      "description": "Type of analysis performed"
    },
    "extracted_text": {
      "type": "string",
      "description": "Cleaned, merged text from all sources (frames + DOM)"
    },
    "text_statistics": {
      "type": "object",
      "properties": {
        "char_count": {
          "type": "integer",
          "description": "Total characters in extracted text"
        },
        "word_count": {
          "type": "integer",
          "description": "Total words in extracted text"
        },
        "sentence_count": {
          "type": "integer",
          "description": "Number of sentences"
        },
        "avg_word_length": {
          "type": "number",
          "description": "Average word length"
        },
        "avg_sentence_length": {
          "type": "number",
          "description": "Average sentence length in words"
        },
        "unique_words": {
          "type": "integer",
          "description": "Count of unique words"
        }
      }
    },
    "cleaning_summary": {
      "type": "object",
      "properties": {
        "original_text_length": {
          "type": "integer",
          "description": "Length before cleaning"
        },
        "cleaned_text_length": {
          "type": "integer",
          "description": "Length after cleaning"
        },
        "items_removed": {
          "type": "object",
          "properties": {
            "emoji_count": {
              "type": "integer"
            },
            "url_count": {
              "type": "integer"
            },
            "mention_count": {
              "type": "integer"
            },
            "hashtag_count": {
              "type": "integer"
            },
            "repeated_char_fixes": {
              "type": "integer"
            }
          }
        }
      }
    },
    "frame_count": {
      "type": "integer",
      "description": "Number of frames processed"
    },
    "frames_analyzed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "ocr_text": {
            "type": "string"
          },
          "ocr_confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "text_valid": {
            "type": "boolean"
          },
          "processing_status": {
            "type": "string",
            "enum": ["success", "low_confidence", "invalid_text", "ocr_failed"]
          }
        }
      }
    },
    "audio_analysis": {
      "type": "object",
      "description": "Audio analysis that triggered image/text processing",
      "properties": {
        "is_silent": {
          "type": "boolean"
        },
        "has_voice": {
          "type": "boolean"
        },
        "voice_ratio": {
          "type": "number"
        },
        "avg_energy": {
          "type": "number"
        }
      }
    },
    "misinfo_predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "prediction", "confidence"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Text segment that was analyzed"
          },
          "prediction": {
            "type": "string",
            "enum": ["REAL", "FAKE", "MIXED"],
            "description": "Classification from RoBERTa model"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Model confidence score"
          },
          "explanation": {
            "type": "string",
            "description": "Human-readable explanation of prediction"
          },
          "similar_claims": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Similar known claims from knowledge base"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of processing"
        },
        "processing_time_ms": {
          "type": "integer",
          "description": "Total processing time in milliseconds"
        },
        "extraction_sources": {
          "type": "integer",
          "description": "Number of text extraction sources used"
        },
        "final_text_length": {
          "type": "integer"
        },
        "text_valid": {
          "type": "boolean",
          "description": "True if final text passed validation"
        },
        "backend_version": {
          "type": "string"
        },
        "model_version": {
          "type": "string",
          "description": "RoBERTa model version used for classification"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "critical"]
          }
        }
      },
      "description": "Non-fatal warnings encountered during processing"
    }
  },
  "examples": [
    {
      "request_id": "req_img_1234567890_abc123",
      "claim_id": "claim_xyz789",
      "status": "success",
      "analysis_type": "image_and_text_extraction",
      "extracted_text": "Amazing deal click here now limited time offer free shipping available today only",
      "text_statistics": {
        "char_count": 87,
        "word_count": 14,
        "sentence_count": 2,
        "avg_word_length": 6.2,
        "avg_sentence_length": 7,
        "unique_words": 12
      },
      "cleaning_summary": {
        "original_text_length": 145,
        "cleaned_text_length": 87,
        "items_removed": {
          "emoji_count": 3,
          "url_count": 2,
          "mention_count": 1,
          "hashtag_count": 2,
          "repeated_char_fixes": 5
        }
      },
      "frame_count": 5,
      "frames_analyzed": [
        {
          "index": 0,
          "ocr_text": "Amazing Deal Click Here Now",
          "ocr_confidence": 0.87,
          "text_valid": true,
          "processing_status": "success"
        },
        {
          "index": 1,
          "ocr_text": "Limited Time Offer Free Shipping",
          "ocr_confidence": 0.82,
          "text_valid": true,
          "processing_status": "success"
        }
      ],
      "audio_analysis": {
        "is_silent": true,
        "has_voice": false,
        "voice_ratio": 0.05,
        "avg_energy": 0.032
      },
      "misinfo_predictions": [
        {
          "text": "Amazing deal click here now",
          "prediction": "FAKE",
          "confidence": 0.87,
          "explanation": "Similar to known deceptive marketing claims promoting false urgency",
          "similar_claims": [
            "Limited time offer trick 123",
            "Click here amazing deal fake"
          ]
        },
        {
          "text": "Limited time offer free shipping",
          "prediction": "MIXED",
          "confidence": 0.62,
          "explanation": "Could be legitimate promotion or misleading scam depending on context",
          "similar_claims": []
        }
      ],
      "meta": {
        "timestamp": "2026-02-25T14:32:45.123Z",
        "processing_time_ms": 2340,
        "extraction_sources": 7,
        "final_text_length": 87,
        "text_valid": true,
        "backend_version": "1.0.0",
        "model_version": "roberta-base-finetuned-2026"
      },
      "warnings": [
        {
          "code": "low_ocr_confidence",
          "message": "Frame 3 had low OCR confidence (0.45), text may be inaccurate",
          "severity": "warning"
        }
      ]
    }
  ]
}
