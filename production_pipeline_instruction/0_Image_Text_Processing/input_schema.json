{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Image/Text Processing Pipeline Input Schema",
  "description": "Input format for Stage 0: Image/Text Processing (silent video alternative to audio extraction)",
  "type": "object",
  "required": ["request_id", "frame_count", "audio_analysis"],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^req_img_[0-9]{10}_[a-zA-Z0-9]{6}$",
      "description": "Unique request identifier, format: req_img_<timestamp>_<random>"
    },
    "claim_id": {
      "type": "string",
      "description": "Associated claim identifier, optional for tracking"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15,
      "description": "Number of video frames captured (1-15)"
    },
    "audio_analysis": {
      "type": "object",
      "required": ["is_silent", "voice_ratio"],
      "properties": {
        "is_silent": {
          "type": "boolean",
          "description": "True if audio analysis detected no significant voice"
        },
        "has_voice": {
          "type": "boolean",
          "description": "True if voice detected above threshold"
        },
        "voice_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Ratio of voice frames to total audio frames (0.0-1.0)"
        },
        "avg_energy": {
          "type": "number",
          "minimum": 0.0,
          "description": "Average RMS energy from audio analysis"
        },
        "decision_reason": {
          "type": "string",
          "enum": ["voice_detected", "insufficient_voice", "below_threshold", "duration_too_short"],
          "description": "Reason for using image/text processing"
        }
      }
    },
    "captured_text": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Text extracted from page DOM (captions, overlays, on-screen text)"
    },
    "dom_text": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Raw DOM text extraction before filtering"
    },
    "frames": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["index", "ocr_text"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "description": "Frame sequence number"
          },
          "timestamp_ms": {
            "type": "number",
            "description": "Timestamp in milliseconds when frame was captured"
          },
          "ocr_text": {
            "type": "string",
            "description": "Text extracted from frame via OCR (client-side Tesseract.js)"
          },
          "ocr_confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "OCR confidence score (0.0-1.0)"
          },
          "visual_change_detected": {
            "type": "boolean",
            "description": "True if frame was captured due to visual change detection"
          },
          "frame_hash": {
            "type": "string",
            "description": "Hash of frame pixels to detect visual changes"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "video_duration_seconds": {
          "type": "number",
          "description": "Total duration of video content"
        },
        "capture_duration_seconds": {
          "type": "number",
          "description": "How long capture was running"
        },
        "extension_version": {
          "type": "string",
          "description": "Version of TruthLens extension"
        },
        "source_url": {
          "type": "string",
          "description": "URL of video source (TikTok, YouTube, etc)"
        },
        "browser_info": {
          "type": "object",
          "properties": {
            "user_agent": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "request_id": "req_img_1234567890_abc123",
      "claim_id": "claim_xyz789",
      "frame_count": 5,
      "audio_analysis": {
        "is_silent": true,
        "has_voice": false,
        "voice_ratio": 0.05,
        "avg_energy": 0.032,
        "decision_reason": "insufficient_voice"
      },
      "captured_text": [
        "Amazing deal click here now",
        "Limited time offer",
        "Free shipping"
      ],
      "dom_text": [
        "Amazing deal click here now",
        "Like and Share",
        "Follow for more",
        "Limited time offer",
        "Free shipping"
      ],
      "frames": [
        {
          "index": 0,
          "timestamp_ms": 0,
          "ocr_text": "Amazing Deal Click Here Now Limited Time Offer Free Shipping",
          "ocr_confidence": 0.87,
          "visual_change_detected": false,
          "frame_hash": "a1b2c3d4e5f6"
        },
        {
          "index": 1,
          "timestamp_ms": 1500,
          "ocr_text": "Limited Time Offer Free Shipping Available",
          "ocr_confidence": 0.82,
          "visual_change_detected": true,
          "frame_hash": "b2c3d4e5f6g7"
        }
      ],
      "metadata": {
        "video_duration_seconds": 15.5,
        "capture_duration_seconds": 10.2,
        "extension_version": "1.0.0",
        "source_url": "https://www.tiktok.com/@user/video/123456",
        "browser_info": {
          "user_agent": "Mozilla/5.0...",
          "language": "en-US"
        }
      }
    }
  ]
}
