{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truthlens.ai/schemas/8_explainability_shap/output_schema.json",
  "title": "8_Explainability_SHAP - Output Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "claim_id",
    "user_claim",
    "normalized_claim",
    "roberta",
    "routing",
    "query_plan",
    "rag_candidates",
    "mmr_selected",
    "evidence_topk",
    "shap_explainability",
    "meta"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "user_claim": {
      "type": "string",
      "minLength": 1
    },
    "normalized_claim": {
      "type": "string",
      "minLength": 1
    },
    "roberta": {
      "$ref": "../7_Light_relevance_gate/output_schema.json#/properties/roberta"
    },
    "routing": {
      "$ref": "../7_Light_relevance_gate/output_schema.json#/properties/routing"
    },
    "query_plan": {
      "$ref": "../7_Light_relevance_gate/output_schema.json#/properties/query_plan"
    },
    "rag_candidates": {
      "$ref": "../7_Light_relevance_gate/output_schema.json#/properties/rag_candidates"
    },
    "mmr_selected": {
      "$ref": "../7_Light_relevance_gate/output_schema.json#/properties/mmr_selected"
    },
    "evidence_topk": {
      "$ref": "../7_Light_relevance_gate/output_schema.json#/properties/evidence_topk"
    },
    "shap_explainability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "explained_class",
        "base_value",
        "output_value",
        "tokens",
        "meta"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "shap_partition",
            "shap_kernel"
          ],
          "description": "SHAP method used for text token attributions."
        },
        "explained_class": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class_id",
            "class_name"
          ],
          "properties": {
            "class_id": {
              "type": "integer",
              "enum": [
                0,
                1,
                2
              ]
            },
            "class_name": {
              "type": "string",
              "enum": [
                "false",
                "mixed",
                "true"
              ]
            }
          }
        },
        "base_value": {
          "type": "number",
          "description": "Expected model output under the background distribution (e.g., logit or prob baseline)."
        },
        "output_value": {
          "type": "number",
          "description": "Model output for the explained class on this instance (e.g., logit or prob)."
        },
        "output_space": {
          "type": "string",
          "enum": [
            "logit",
            "probability"
          ],
          "description": "Whether SHAP sums are in logit or probability space."
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "description": "Token-level attributions for the claim text.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "i",
              "token",
              "shap_value"
            ],
            "properties": {
              "i": {
                "type": "integer",
                "minimum": 0
              },
              "token": {
                "type": "string"
              },
              "shap_value": {
                "type": "number",
                "description": "Contribution of this token to the explained output."
              },
              "char_span": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "top_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k",
            "positive",
            "negative"
          ],
          "properties": {
            "k": {
              "type": "integer",
              "minimum": 1
            },
            "positive": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "description": "Indices of top-k positive-contribution tokens."
            },
            "negative": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "description": "Indices of top-k negative-contribution tokens."
            }
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "nsamples"
          ],
          "properties": {
            "background": {
              "type": "string",
              "description": "Identifier of the background dataset/strategy used by SHAP."
            },
            "nsamples": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of samples used by the SHAP approximation."
            },
            "time_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "stage_latencies_ms": {
          "type": "object",
          "description": "Per-stage latency in milliseconds, keyed by stage name.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total end-to-end latency in milliseconds (sum of stage latencies plus overhead)."
        },
        "stage_errors": {
          "type": "array",
          "description": "Non-fatal stage errors encountered during processing (pipeline continued).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "code",
              "message"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "description": "Optional structured details for debugging.",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}