{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truthlens.ai/schemas/3_routing_policy/input_schema.json",
  "title": "3_Routing_policy - Input Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "claim_id",
    "user_claim",
    "normalized_claim",
    "roberta",
    "meta"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "user_claim": {
      "type": "string",
      "minLength": 1
    },
    "normalized_claim": {
      "type": "string",
      "minLength": 1
    },
    "roberta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "confidence",
        "model",
        "tokenization"
      ],
      "properties": {
        "label": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logits",
            "probs",
            "class_id",
            "class_name"
          ],
          "properties": {
            "logits": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "probs": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "class_id": {
              "type": "integer",
              "enum": [
                0,
                1,
                2
              ]
            },
            "class_name": {
              "type": "string",
              "enum": [
                "false",
                "mixed",
                "true"
              ]
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "embedding": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Optional CLS embedding (e.g., length 768)."
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "revision",
            "ctx_tokens"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "ctx_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tokenization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "truncated",
            "input_tokens"
          ],
          "properties": {
            "truncated": {
              "type": "boolean"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received_at",
        "version"
      ],
      "properties": {
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stage_latencies_ms": {
          "type": "object",
          "description": "Per-stage latency in milliseconds, keyed by stage name.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total end-to-end latency in milliseconds (sum of stage latencies plus overhead)."
        },
        "stage_errors": {
          "type": "array",
          "description": "Non-fatal stage errors encountered during processing (pipeline continued).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "code",
              "message"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "description": "Optional structured details for debugging.",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}