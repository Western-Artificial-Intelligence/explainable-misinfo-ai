# Optional: if set, frontend calls backend directly using this URL.
# If left empty, Vite dev server proxy is used (configured in vite.config.ts).
VITE_API_BASE_URL=

# Optional: override proxy target in local development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional backup sync to backend /history endpoint.
# Local browser history works even when this is false or backend is down.
VITE_HISTORY_SYNC_TO_BACKEND=true

# Optional: load central backend history into UI on startup.
# Keep false for strict per-device-only history in the browser.
VITE_HISTORY_LOAD_REMOTE=false
