# TruthLens Backend - copy to .env and adjust as needed

# Ollama (for LLM claim extraction) - LOCAL
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_S=60

# For Ollama Cloud (ollama.com) - comment out the 3 lines above and uncomment below
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=your_key_from_ollama.com/settings/keys

# RoBERTa model (optional - uses heuristic fallback if not set)
# TRUTHLENS_CHECKPOINT_PATH=path/to/best.ckpt
