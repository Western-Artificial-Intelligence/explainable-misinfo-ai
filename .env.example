# Copy to .env and fill in values. Do not commit .env.

HF_HOME=.cache/huggingface
HF_TOKEN=
MODEL_NAME=distilbert-base-uncased
NUM_LABELS=3
MAX_LEN=256
LR=2e-5
BATCH=16
EPOCHS=3
API_SECRET=

# Audio / Whisper (local openai-whisper: no API key needed; for OpenAI Whisper API set OPENAI_API_KEY)
WHISPER_MODEL_SIZE=base
# OPENAI_API_KEY=
