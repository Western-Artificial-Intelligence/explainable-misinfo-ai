# Backend (Ollama)
# Local: OLLAMA_BASE_URL=http://127.0.0.1:11434, leave OLLAMA_API_KEY empty
# Cloud: OLLAMA_BASE_URL=https://ollama.com, OLLAMA_MODEL=gpt-oss:20b-cloud, set OLLAMA_API_KEY
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_S=60
OLLAMA_API_KEY=

# MongoDB (optional, but required for persistent history across sessions)
# Replace <db_password> with your real database password.
MONGO_URI=mongodb+srv://khimaniaryan_db_user:<db_password>@waicluster0.eeyuita.mongodb.net/?appName=WAICluster0
# Backward compatibility (optional)
# MONGODB_URI=
MONGODB_DB_NAME=truthlens
MONGODB_HISTORY_COLLECTION=history
MONGODB_CONNECT_TIMEOUT_MS=5000

# Frontend
# Leave empty to use Vite dev proxy to http://127.0.0.1:8000
VITE_API_BASE_URL=
